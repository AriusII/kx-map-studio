<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>KXMapStudio.ico</ApplicationIcon>
		
		<!-- Disable trimming for WPF application (MaterialDesign + WPF limitations) -->
		<PublishTrimmed>false</PublishTrimmed>
		
		<!-- Enable assembly info generation -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\..\Libs\KXMapStudio.Libs\KXMapStudio.Libs.csproj"/>
	</ItemGroup>
	
	<ItemGroup>
		<Resource Include="KXMapStudio.ico">
			<Link>Resources\KXMapStudio.ico</Link>
		</Resource>
	</ItemGroup>
	
	<ItemGroup>
		<Page Update="Views\Windows\WorkspaceWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
			<XamlRuntime>Wpf</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>
	
	<ItemGroup>
		<None Remove="appsettings.json"/>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
