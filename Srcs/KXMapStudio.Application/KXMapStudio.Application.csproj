<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Platforms>x64</Platforms>
		<Version>0.4.0</Version>
		<ApplicationIcon>KXMapStudio.ico</ApplicationIcon>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\..\Libs\KXMapStudio.Libs\KXMapStudio.Libs.csproj"/>
	</ItemGroup>
	
	<ItemGroup>
		<Resource Include="KXMapStudio.ico">
			<Link>Resources\KXMapStudio.ico</Link>
		</Resource>
	</ItemGroup>
	
	<ItemGroup>
		<Page Update="Views\Windows\WorkspaceWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
			<XamlRuntime>Wpf</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>
	
	<ItemGroup>
	  <None Remove="appsettings.json" />
	  <Content Include="appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

</Project>
