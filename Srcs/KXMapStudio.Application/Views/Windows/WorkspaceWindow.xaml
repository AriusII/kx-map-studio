<Window x:Class="KXMapStudio.Application.Views.Windows.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:leftSide="clr-namespace:KXMapStudio.Libs.Views.UsersControls.LeftSide;assembly=KXMapStudio.Libs"
        Style="{StaticResource MaterialDesignWindow}"
        Title="WorkspaceWindow" Height="800" Width="1280">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" MinWidth="200" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" MinWidth="400" />
			</Grid.ColumnDefinitions>

			<!-- Left Panel -->
			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" MinHeight="100" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="2*" MinHeight="100" />
				</Grid.RowDefinitions>

				<leftSide:WorkspaceExplorerUserControl
					Grid.Row="0"
					DataContext="{Binding LeftPanel}" />

				<GridSplitter Grid.Row="1"
				              Height="4"
				              HorizontalAlignment="Stretch"
				              VerticalAlignment="Center"
				              Background="Transparent"
				              ShowsPreview="True" />

				<leftSide:FilePreviewUserControl
					Grid.Row="2"
					DataContext="{Binding LeftPanel}" />
			</Grid>

			<!-- Horizontal Splitter Left-Center -->
			<GridSplitter Grid.Column="1"
			              Width="4"
			              HorizontalAlignment="Center"
			              VerticalAlignment="Stretch"
			              Background="Transparent"
			              ShowsPreview="True" />

		</Grid>
	</Grid>
</Window>