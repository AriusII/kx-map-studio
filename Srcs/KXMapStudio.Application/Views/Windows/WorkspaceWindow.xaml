<Window x:Class="KXMapStudio.Application.Views.Windows.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:leftSide="clr-namespace:KXMapStudio.Libs.Views.LeftSide;assembly=KXMapStudio.Libs"
        xmlns:gridEditor="clr-namespace:KXMapStudio.Libs.Views.RightSide.GridEditor;assembly=KXMapStudio.Libs"
        xmlns:topSide="clr-namespace:KXMapStudio.Libs.Views.TopSide.MainMenu;assembly=KXMapStudio.Libs"
        Style="{StaticResource MaterialDesignWindow}"
        Title="WorkspaceWindow" Height="800" Width="1280">

	<Window.InputBindings>
		<KeyBinding Key="S" Modifiers="Control" Command="{Binding MainMenu.SaveCommand}" />
		<KeyBinding Key="D" Modifiers="Control" Command="{Binding MainMenu.SaveAsCommand}" />
		<KeyBinding Key="Z" Modifiers="Control" Command="{Binding MainMenu.UndoCommand}" />
		<KeyBinding Key="Y" Modifiers="Control" Command="{Binding MainMenu.RedoCommand}" />
	</Window.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<topSide:MainMenuUserControl Grid.Row="0" DataContext="{Binding MainMenu}" />

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" MinWidth="400" />
			</Grid.ColumnDefinitions>

			<!-- Left panel (docked left) -->
			<leftSide:LeftSidePanelUserControl
				Grid.Column="0"
				Width="280"
				MinWidth="200"
				HorizontalAlignment="Left"
				DataContext="{Binding LeftPanel}" />

			<!-- Horizontal splitter Left-Center -->
			<GridSplitter Grid.Column="1"
			              Width="4"
			              HorizontalAlignment="Center"
			              VerticalAlignment="Stretch"
			              Background="Transparent"
			              ShowsPreview="True" />

			<!-- Grid editor -->
			<gridEditor:GridEditorUserControl
				Grid.Column="2"
				DataContext="{Binding GridEditor}" />
		</Grid>
	</Grid>
</Window>