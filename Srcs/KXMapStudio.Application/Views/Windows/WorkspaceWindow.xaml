<Window x:Class="KXMapStudio.Application.Views.Windows.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:leftSide="clr-namespace:KXMapStudio.Libs.Views.LeftSide;assembly=KXMapStudio.Libs"
        xmlns:gridEditor="clr-namespace:KXMapStudio.Libs.Views.RightSide.GridEditor;assembly=KXMapStudio.Libs"
        Style="{StaticResource MaterialDesignWindow}"
        Title="WorkspaceWindow" Height="800" Width="1280">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" MinWidth="400" />
			</Grid.ColumnDefinitions>

			<!-- Left panel (docked left) -->
			<leftSide:LeftSidePanelUserControl
				Grid.Column="0"
				Width="280"
				MinWidth="200"
				HorizontalAlignment="Left"
				DataContext="{Binding LeftPanel}" />

			<!-- Horizontal splitter Left-Center -->
			<GridSplitter Grid.Column="1"
			              Width="4"
			              HorizontalAlignment="Center"
			              VerticalAlignment="Stretch"
			              Background="Transparent"
			              ShowsPreview="True" />

			<!-- Center / Right content placeholder -->
			<gridEditor:GridEditorUserControl
				Grid.Column="2" 
				/>
		</Grid>
	</Grid>
</Window>