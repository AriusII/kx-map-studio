<Window x:Class="KXMapStudio.Application.Views.Windows.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KXMapStudio.Libs.Views.UsersControls;assembly=KXMapStudio.Libs"
        xmlns:workspace="clr-namespace:KXMapStudio.Libs.ViewModels.Workspace;assembly=KXMapStudio.Libs"
        Style="{StaticResource MaterialDesignWindow}"
        Title="WorkspaceWindow" Height="800" Width="1280">
	<Window.DataContext>
		<workspace:WorkspaceWindowViewModel />
	</Window.DataContext>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<views:MainMenuUserControl Grid.Row="0"
		                           DataContext="{Binding MainMenu}" />

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="260" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="300" />
			</Grid.ColumnDefinitions>

			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="2*" />
				</Grid.RowDefinitions>
				<views:WorkspaceExplorerUserControl Grid.Row="0"
				                                    DataContext="{Binding LeftWorkspace}" />
				<views:FilePreviewUserControl Grid.Row="1"
				                              DataContext="{Binding LeftWorkspace}" />
			</Grid>

			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<views:GridViewUserControl Grid.Row="0"
				                           DataContext="{Binding CenterWorkspace}" />
				<views:GridEditorUserControl Grid.Row="1"
				                             DataContext="{Binding CenterWorkspace}" />
			</Grid>

			<views:RightPanelUserControl Grid.Column="2"
			                             DataContext="{Binding RightWorkspace}" />
		</Grid>
	</Grid>
</Window>