<UserControl x:Class="KXMapStudio.Libs.Views.LeftSide.LeftSidePanelUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:workshopExplorer1="clr-namespace:KXMapStudio.Libs.Views.LeftSide.WorkshopExplorer"
             xmlns:filePreview1="clr-namespace:KXMapStudio.Libs.Views.LeftSide.FilePreview"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" MinHeight="100" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="2*" MinHeight="100" />
		</Grid.RowDefinitions>

		<workshopExplorer1:WorkspaceExplorerUserControl
			Grid.Row="0"
			DataContext="{Binding WorkshopExplorer}" />

		<GridSplitter Grid.Row="1"
		              Height="4"
		              HorizontalAlignment="Stretch"
		              VerticalAlignment="Center"
		              Background="Transparent"
		              ShowsPreview="True" />

		<filePreview1:FilePreviewUserControl
			Grid.Row="2"
			DataContext="{Binding FilePreview}" />
	</Grid>
</UserControl>