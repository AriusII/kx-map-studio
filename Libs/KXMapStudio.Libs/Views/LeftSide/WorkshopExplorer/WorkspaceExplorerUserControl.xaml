<UserControl
	x:Class="KXMapStudio.Libs.Views.LeftSide.WorkshopExplorer.WorkspaceExplorerUserControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:workshopExplorer="clr-namespace:KXMapStudio.Libs.Models.LeftSide.WorkshopExplorer"
	mc:Ignorable="d"
	d:DesignHeight="450"
	d:DesignWidth="300">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Header with Refresh Button -->
		<Border
			Grid.Row="0"
			Background="{DynamicResource MaterialDesign.Brush.Surface}"
			BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
			BorderThickness="0,0,0,1"
			Padding="12,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!-- Folder Icon -->
				<materialDesign:PackIcon Grid.Column="0"
				                         Kind="FolderOpen"
				                         Width="24" Height="24"
				                         VerticalAlignment="Center"
				                         Margin="0,0,12,0"
				                         Foreground="{StaticResource Kx.Brush.Text.Secondary}" />

				<!-- Title -->
				<TextBlock
					Grid.Column="1"
					Text="Workshop Explorer"
					VerticalAlignment="Center"
					FontWeight="SemiBold"
					FontSize="13" />

				<!-- Refresh Button -->
				<Button
					Grid.Column="2"
					Style="{StaticResource MaterialDesignToolButton}"
					ToolTip="Refresh folder tree"
					Command="{Binding RefreshCommand}">
					<materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
				</Button>
			</Grid>
		</Border>

		<!-- TreeView for Files and Folders -->
		<TreeView
			Grid.Row="1"
			ItemsSource="{Binding RootNodes}"
			BorderThickness="0"
			Background="Transparent"
			VirtualizingPanel.IsVirtualizing="True"
			VirtualizingPanel.VirtualizationMode="Recycling"
			ScrollViewer.HorizontalScrollBarVisibility="Auto"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			SelectedItemChanged="TreeView_OnSelectedItemChanged">
			<TreeView.Resources>
				<!-- Style for TreeViewItem -->
				<Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
					<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
					<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
				</Style>
			</TreeView.Resources>

			<!-- Hierarchical Data Template -->
			<TreeView.ItemTemplate>
				<HierarchicalDataTemplate DataType="{x:Type workshopExplorer:WorkshopExplorerNodeModel}"
				                          ItemsSource="{Binding Children}">
					<StackPanel Orientation="Horizontal">
						<!-- Icon for Directory or File -->
						<materialDesign:PackIcon
							Width="16"
							Height="16"
							Margin="0,0,4,0"
							VerticalAlignment="Center">
							<materialDesign:PackIcon.Style>
								<Style TargetType="materialDesign:PackIcon">
									<Style.Triggers>
										<!-- Directory Icon -->
										<DataTrigger Binding="{Binding IsDirectory}" Value="True">
											<Setter Property="Kind" Value="Folder" />
											<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
										</DataTrigger>
										<!-- XML File Icon -->
										<DataTrigger Binding="{Binding Extension}" Value=".xml">
											<Setter Property="Kind" Value="FileXmlBox" />
											<Setter Property="Foreground" Value="#FF9800" />
										</DataTrigger>
										<!-- JSON File Icon -->
										<DataTrigger Binding="{Binding Extension}" Value=".json">
											<Setter Property="Kind" Value="CodeJson" />
											<Setter Property="Foreground" Value="#4CAF50" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</materialDesign:PackIcon.Style>
						</materialDesign:PackIcon>

						<!-- File/Folder Name -->
						<TextBlock
							Text="{Binding Name}"
							VerticalAlignment="Center" />
					</StackPanel>
				</HierarchicalDataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
	</Grid>
</UserControl>