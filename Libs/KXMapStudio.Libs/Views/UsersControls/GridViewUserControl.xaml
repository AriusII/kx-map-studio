<UserControl x:Class="KXMapStudio.Libs.Views.UsersControls.GridViewUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:workspace="clr-namespace:KXMapStudio.Libs.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance Type=workspace:CenterWorkspaceViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
		           Text="{Binding Status}"
		           Margin="8"
		           FontSize="14"
		           FontWeight="SemiBold" />

		<DataGrid Grid.Row="1"
		          ItemsSource="{Binding Rows}"
		          AutoGenerateColumns="True"
		          IsReadOnly="True"
		          Margin="8" />
	</Grid>
</UserControl>