<UserControl x:Class="KXMapStudio.Libs.Views.BottomSide.StatusBar.StatusBarUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="26" d:DesignWidth="900">


	<Border Padding="10,6"
	        Background="{StaticResource MaterialDesign.Brush.Surface}"
	        BorderBrush="{StaticResource MaterialDesign.Brush.Separator}"
	        BorderThickness="0,1,0,0">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- Connection dot: Red = disconnected, Yellow = available but stale/connecting, Green = connected -->
			<Ellipse Grid.Column="0"
			         Width="10" Height="10"
			         VerticalAlignment="Center"
			         Margin="0,0,10,0">
				<Ellipse.Style>
					<Style TargetType="Ellipse">
						<Setter Property="Fill" Value="{StaticResource Kx.Brush.Status.Error}" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsMumbleAvailable}" Value="True">
								<Setter Property="Fill" Value="{StaticResource Kx.Brush.Status.Warning}" />
							</DataTrigger>
							<DataTrigger Binding="{Binding IsMumbleConnected}" Value="True">
								<Setter Property="Fill" Value="{StaticResource Kx.Brush.Status.Success}" />
								<DataTrigger.EnterActions>
									<BeginStoryboard>
										<Storyboard RepeatBehavior="Forever" AutoReverse="True">
											<DoubleAnimation Storyboard.TargetProperty="Opacity"
											                 From="1.0" To="0.4"
											                 Duration="0:0:1.5" />
										</Storyboard>
									</BeginStoryboard>
								</DataTrigger.EnterActions>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Ellipse.Style>
			</Ellipse>

			<!-- Character + Map -->
			<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
				<TextBlock Text="{Binding CharacterName}" FontWeight="SemiBold" />
				<TextBlock Text="   " />
				<TextBlock Text="{Binding MapText}" Opacity="0.85" />
			</StackPanel>

			<!-- Coordinates: separate fields for readability -->
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
				<TextBlock Text="{Binding XText}" Margin="0,0,12,0" />
				<TextBlock Text="{Binding YText}" Margin="0,0,12,0" />
				<TextBlock Text="{Binding ZText}" />
			</StackPanel>

			<!-- Social links: Website, Discord, GitHub -->
			<StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
				<!-- Website button -->
				<Button Style="{StaticResource MaterialDesignFlatButton}"
				        Command="{Binding OpenWebsiteCommand}"
				        ToolTip="Visit KXTools Website"
				        Height="24" Width="24"
				        Padding="0"
				        Margin="4,0">
					<materialDesign:PackIcon Kind="Web" Width="16" Height="16" />
				</Button>

				<!-- Discord button -->
				<Button Style="{StaticResource MaterialDesignFlatButton}"
				        Command="{Binding OpenDiscordCommand}"
				        ToolTip="Join our Discord"
				        Height="24" Width="24"
				        Padding="0"
				        Margin="4,0">
					<materialDesign:PackIcon Kind="Forum" Width="16" Height="16" />
				</Button>

				<!-- GitHub button -->
				<Button Style="{StaticResource MaterialDesignFlatButton}"
				        Command="{Binding OpenGitHubCommand}"
				        ToolTip="View on GitHub"
				        Height="24" Width="24"
				        Padding="0"
				        Margin="4,0">
					<materialDesign:PackIcon Kind="Github" Width="16" Height="16" />
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>